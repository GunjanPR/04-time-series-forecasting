# Copy to .env and fill in. Never commit .env.
# ---- Paths ----
DATA_DIR=./data
RESULTS_DIR=./results

# ---- Benchmark settings ----
# Default dataset: m4-monthly | m4-daily | m5-subset | energy
DATASET=m4-monthly
# Forecast horizon (steps) and number of rolling-origin windows
HORIZON=18
N_WINDOWS=3
# Max series to sample (blank = all)
MAX_SERIES=500
RANDOM_SEED=42
# Parallel workers (-1 = all cores)
N_JOBS=-1

# ---- Optional: Kaggle (only to download M5) ----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Optional: MLflow experiment logging (blank disables) ----
MLFLOW_TRACKING_URI=

# Copy to .env and fill in. Never commit .env.
# ---- Paths ----
DATA_DIR=./data
RESULTS_DIR=./results

# ---- Benchmark settings ----
# Dataset: m4-monthly | electricity-daily
DATASET=m4-monthly
# Forecast horizon (steps) and number of rolling-origin windows; blank = dataset default
# (m4-monthly: 18 and 3, electricity-daily: 14 and 3)
HORIZON=
N_WINDOWS=
# Max series to sample (blank = all)
MAX_SERIES=500
RANDOM_SEED=42
# Parallel workers (-1 = all cores)
N_JOBS=-1

# ---- Optional: Kaggle (only to download M5) ----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Optional: MLflow experiment logging (blank disables) ----
MLFLOW_TRACKING_URI=
